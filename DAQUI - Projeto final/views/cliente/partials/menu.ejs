<!-- Cabeçalho (Navbar) -->
<header>
    <!-- Logotipo -->
    <div class="logo-area">
        <img src="/img/logo.png" alt="">
    </div>

    <!-- Barra de Pesquisa -->
    <form action="/busca" method="get" class="pesquisar">
        <input type="text" name="q" placeholder="O que você procura?" required>
        <button type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>
    </form>

    <!-- Links de Navegação -->
    <nav>
    <ul>
        <li><a href="/">Início</a></li>
        <li><a href="/">Sobre nós</a></li>
        <li><a href="#cidades">Cidades</a></li>
        <li><a href="#contato">Contato</a></li>
        
        <!-- BOTÃO E POPUP JUNTOS AQUI -->
        <li class="li-categorias" style="position: relative;">
    <a href="javascript:void(0)" id="btnCategorias" style="display: flex; align-items: center; gap: 5px;">
        Categorias <i class="fa-solid fa-bars" style="font-size: 11px;"></i>
    </a>

    <!-- POPUP -->
    <div class="popup-categorias" id="popupCategorias" hidden>
        <button class="popup-fechar" id="btnFecharCategorias" aria-label="Fechar">✕</button>
        
        <div class="popup-conteudo">
            <h3>Categorias</h3>
            
            <!-- O forEach roda aqui e o CSS Grid organiza em 2 colunas -->
            <ul class="lista-categorias">
                <% categorias.forEach(categoria => { %>
                    <li>
                        <a href="/categoria/<%= categoria.id %>"><%= categoria.nome %></a>
                    </li>
                <% }); %>
            </ul>
        </div>
    </div>
</li>
        <!-- FIM DO BOTÃO E POPUP -->

    </ul>
</nav>

    <!-- Ações Direita -->
    <div class="header-actions">
        <a href="/carrinho" class="cart-icon">
            <i class="fa-solid fa-basket-shopping fa-xl"></i>
        </a>
        <div class="user-profile">
            <div class="user-avatar">
                <i class="fa-solid fa-user"></i>
            </div>
            <span>Olá, user.</span>
        </div>
    </div>

</header>